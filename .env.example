APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/maie6000c
AI_SERVICE_URL=http://ai:8100
WORKER_POLL_SECONDS=2.0
WORKER_REQUEST_TIMEOUT_SECONDS=20.0
API_HOST_PORT=8000
AI_HOST_PORT=8100
POSTGRES_HOST_PORT=5432

# LLM extraction (optional). Use heuristic for rule-only local runs.
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=
# LLM_API_KEY_HEADER=api-key
# LLM_TIMEOUT_SECONDS=8
# LLM_PROMPT_VERSION=review-extraction-v1

# Semantic grouping (Compose AI image installs sentence-transformers).
GROUPING_ENABLED=true
GROUPING_SIMILARITY_THRESHOLD=0.35
GROUPING_OVERLAP_THRESHOLD=0.55
GROUPING_TOP2_MARGIN=0.08
GROUPING_KEYWORD_GATE=true
GROUPING_EMBEDDING_BACKEND=sentence_transformers
GROUPING_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
